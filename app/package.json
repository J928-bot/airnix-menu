{
  "name": "airnix-menu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB --port 8788",
    "db:local": "wrangler d1 execute airnix-menu --local --file=schema.sql",
    "db:remote": "wrangler d1 execute airnix-menu --remote --file=schema.sql",
    "deploy": "wrangler pages deploy public",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260917.0",
    "typescript": "5.9.3",
    "wrangler": "4.40.0"
  }
}
